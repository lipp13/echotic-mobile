{
  "expo": {
    "name": "EchoTic-Mobile",
    "slug": "EchoTic-Mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "echotic",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#07070a",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.echotic.app"
    },
    "android": {
      "package": "com.echotic.app",
      "adaptiveIcon": {
        "backgroundColor": "#07070a",
        "foregroundImage": "./assets/android-icon-foreground.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-image",
      "expo-font"
    ]
  }
}
